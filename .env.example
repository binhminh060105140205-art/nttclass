DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
NODE_ENV=development
ALLOW_DEV_OTP=false


# Render production: đặt NODE_ENV=production, RESEND_API_KEY và EMAIL_FROM
# trong Dashboard > Environment. Không bật ALLOW_DEV_OTP trên production.
# Resend dùng riêng cho email OTP và phải là khóa bắt đầu bằng re_.
