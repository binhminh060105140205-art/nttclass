PORT=3000
DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
NODE_ENV=development
ALLOW_DEV_OTP=true

# OpenAI dùng cho Trợ lý AI. Chỉ đặt khóa thật trong .env local hoặc Environment của Render.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# Render production: đặt NODE_ENV=production, RESEND_API_KEY và EMAIL_FROM
# trong Dashboard > Environment. Không bật ALLOW_DEV_OTP trên production.
# Resend dùng riêng cho email OTP và phải là khóa bắt đầu bằng re_.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=NttClass <no-reply@ten-mien-da-xac-minh.com>
